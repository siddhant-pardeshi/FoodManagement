# Local development environment for the API (npm run dev:api).
# Never commit the real .env file.

# Cloud MySQL (Aiven) or a local MySQL instance.
DATABASE_URL=mysql://user:password@host:3306/dbname

# Initial admin account, created only when the email does not exist yet.
ADMIN_EMAIL=admin@khaanabachaao.in
ADMIN_PASSWORD=Admin@123

# Optional: frontend origins allowed to call the API when not served from
# the same origin (the Vercel deployment needs no CORS at all).
# CORS_ORIGINS=http://localhost:5173
